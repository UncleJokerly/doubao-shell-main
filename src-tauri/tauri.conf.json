{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doubao-shell",
  "version": "0.1.0",
  "identifier": "com.doubao.shell",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "https://www.doubao.com/",
    "beforeBuildCommand": "",
    "frontendDist": "https://www.doubao.com/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "豆包",
        "width": 420,
        "height": 720,
        "minWidth": 340,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer.nsh"
      }
    }
  }
}
